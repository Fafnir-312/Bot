    const rowSelector = document.getElementById('rowSelector');
    const intervalsBadge = document.getElementById('intervalsBadge');
    const autoIntervalBtn = document.getElementById('autoIntervalBtn');
    const tableBody = document.getElementById('tableBody');
    const calcBtn = document.getElementById('calcBtn');
    const clearBtn = document.getElementById('clearBtn');
    const copyBtn = document.getElementById('copyBtn');
    const statusBanner = document.getElementById('statusBanner');

    const summaryDelta1 = document.getElementById('summaryDelta1');
    const summaryAvg1 = document.getElementById('summaryAvg1');
    const summarySteps1 = document.getElementById('summarySteps1');
    const summaryDelta2 = document.getElementById('summaryDelta2');
    const summaryAvg2 = document.getElementById('summaryAvg2');
    const summarySteps2 = document.getElementById('summarySteps2');

    function pluralizeIntervals(count) {
      if (count === 1) return '1 проміжок';
      if (count >= 2 && count <= 4) return count + ' проміжки';
      return count + ' проміжків';
    }

    function showBanner(message, type) {
      statusBanner.textContent = message;
      statusBanner.classList.remove(
        'hidden',
        'bg-rose-50', 'text-rose-800', 'border-rose-200',
        'bg-emerald-50', 'text-emerald-800', 'border-emerald-200',
        'bg-amber-50', 'text-amber-800', 'border-amber-200'
      );
      if (type === 'error') {
        statusBanner.classList.add('bg-rose-50', 'text-rose-800', 'border-rose-200');
      } else if (type === 'success') {
        statusBanner.classList.add('bg-emerald-50', 'text-emerald-800', 'border-emerald-200');
      } else {
        statusBanner.classList.add('bg-amber-50', 'text-amber-800', 'border-amber-200');
      }
    }

    function hideBanner() {
      statusBanner.classList.add('hidden');
      statusBanner.textContent = '';
    }

    function parseTimeMinutes(str) {
      const trimmed = (str || '').trim();
      const match = /^(\d{1,2}):(\d{2})$/.exec(trimmed);
      if (!match) return null;
      const hours = Number(match[1]);
      const mins = Number(match[2]);
      if (hours < 0 || hours > 23 || mins < 0 || mins > 59) return null;
      return hours * 60 + mins;
    }

    function formatMinutes(totalMins) {
      const normalized = ((Math.round(totalMins) % 1440) + 1440) % 1440;
      const h = String(Math.floor(normalized / 60)).padStart(2, '0');
      const m = String(normalized % 60).padStart(2, '0');
      return h + ':' + m;
    }

    function interpolateTimes(startStr, endStr, rowCount) {
      const startMins = parseTimeMinutes(startStr);
      const result = new Array(rowCount).fill('');
      result[0] = startStr.trim();
      result[rowCount - 1] = endStr.trim();

      if (startMins === null || rowCount <= 2) {
        return result;
      }

      for (let i = 1; i < rowCount - 1; i++) {
        result[i] = formatMinutes(startMins + i * STEP_MINUTES);
      }
      return result;
    }

    function distributeIntegers(startVal, endVal, intervals) {
      const delta = endVal - startVal;
      const values = [startVal];
      const steps = [];

      for (let i = 1; i <= intervals; i++) {
        const nextVal = startVal + Math.round((i * delta) / intervals);
        steps.push(nextVal - values[i - 1]);
        values.push(nextVal);
      }

      return { values, steps, delta, avg: delta / intervals };
    }

    function formatSigned(num) {
      if (num > 0) return '+' + num;
      return String(num);
    }

    function summarizeSteps(steps) {
      if (!steps || steps.length === 0) return '—';
      const counts = new Map();
      for (const s of steps) {
        